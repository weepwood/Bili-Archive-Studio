{
  "manifest_version": 3,
  "name": "Bili Archive Studio 采集助手",
  "version": "0.4.1",
  "description": "登录 B 站后，在本地客户端关联账号并启动动态采集；不会上传 Cookie。",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://*.bilibili.com/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Bili Archive Studio 账号关联与采集",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
